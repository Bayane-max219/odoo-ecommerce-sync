<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sync_log_list" model="ir.ui.view">
        <field name="name">ecommerce.sync.log.list</field>
        <field name="model">ecommerce.sync.log</field>
        <field name="arch" type="xml">
            <tree string="Sync Logs" create="0" edit="0">
                <field name="create_date" string="Date"/>
                <field name="backend_id"/>
                <field name="operation"/>
                <field name="external_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'warning'"
                       decoration-danger="state == 'error'"/>
                <field name="message"/>
            </tree>
        </field>
    </record>

    <record id="view_sync_log_search" model="ir.ui.view">
        <field name="name">ecommerce.sync.log.search</field>
        <field name="model">ecommerce.sync.log</field>
        <field name="arch" type="xml">
            <search string="Sync Logs">
                <field name="backend_id"/>
                <field name="external_id"/>
                <filter name="errors" string="Errors" domain="[('state','=','error')]"/>
                <filter name="warnings" string="Warnings" domain="[('state','=','warning')]"/>
                <separator/>
                <filter name="products" string="Products"
                        domain="[('operation','in',['import_product','export_product'])]"/>
                <filter name="orders" string="Orders"
                        domain="[('operation','=','import_order')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_backend" string="Backend"
                            context="{'group_by': 'backend_id'}"/>
                    <filter name="group_operation" string="Operation"
                            context="{'group_by': 'operation'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sync_logs" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">ecommerce.sync.log</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_sync_log_search"/>
    </record>

</odoo>
